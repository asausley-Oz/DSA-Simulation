# Copy to .env and fill in. .env is git-ignored.

# --- Planning Center (required) ---
# Create a Personal Access Token at:
#   https://api.planningcenteronline.com/oauth/applications  -> Personal Access Tokens
# The token is an Application ID + Secret pair (read access to People is enough).
PCO_APP_ID=
PCO_SECRET=

# --- What to pull ---
# PCO_SOURCE: "names" (look people up by name), "list" (a Planning Center List),
#             or "all" (whole account)
PCO_SOURCE=names
# Used when PCO_SOURCE=names. One name per line in this file.
PCO_NAMES_FILE=people.txt
# Required when PCO_SOURCE=list. Run `python -m planning_center_carehub.cli lists` to find it.
PCO_LIST_ID=
# Optional filter when PCO_SOURCE=all, e.g. active
PCO_STATUS_FILTER=

# --- Visit request defaults ---
VISIT_REQUEST_TYPE=Visit
VISIT_PRIORITY=Normal

# --- Output ---
OUTPUT_DIR=output
STATE_PATH=output/sync_state.json

# --- Optional: direct submission to CareHub (advanced, opt-in) ---
# Leave BLANK to use the safe default (writes CSV + worksheet for manual entry).
# Only set these if you have an authorized way to post to your own CareHub
# account (e.g. an official import endpoint, or a request captured from your
# own logged-in browser session).
CAREHUB_SUBMIT_URL=
CAREHUB_AUTH_HEADER=
